### Core database — DO NOT commit real credentials. Copy to .env locally.
# SQLite (local):
DB_URL=sqlite:///iam_governance.db
# Postgres (set via secrets manager in prod; example only):
# DB_URL=postgres://USER:***@HOST:5432/iam_governance?sslmode=require

### AWS + region
AWS_REGION=us-east-1
# AWS_PROFILE=default

### IAM discovery
MOCK_IAM=true
# Required when MOCK_IAM=false for IAM user and role scans; validated against STS.
# AWS_ACCOUNT_ID=123456789012

### Safety gates (remediation)
DRY_RUN=true
ENABLE_REMEDIATION=false
ALLOW_LIVE_REMEDIATION=false
REMEDIATION_ALLOWLIST=
REMEDIATION_DENYLIST=
# Staging live actions additionally require APP_ENV=staging, AWS_ACCOUNT_ID,
# and a recorded acceptance identifier; production remains code-blocked.
STAGING_REMEDIATION_ACCEPTANCE_ID=
REMEDIATION_WORKER_ID=

### Audit export
AUDIT_S3_BUCKET=
AUDIT_S3_PREFIX=
LOCAL_ONLY=true

### Logging
LOG_LEVEL=INFO

### GenAI (optional)
# Disabled by default. Review docs/production-readiness.md and docs/ai-quality-gates.md.
ENABLE_GENAI=false
# GOOGLE_API_KEY=
# GENAI_MODEL=gemini-3.8-flash
AI_PROVIDER_DATA_APPROVED=false
# AI_PSEUDONYM_KEY=provide-via-secret-manager

### Environment and OIDC reviewer API
APP_ENV=development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_GROUP_CLAIM=groups
OIDC_ACCOUNT_SCOPE_CLAIM=aws_account_scopes
REVIEWER_GROUP=
CAMPAIGN_ADMIN_GROUP=
REMEDIATION_APPROVER_GROUP=
REMEDIATION_OPERATOR_GROUP=
AUDITOR_GROUP=

### Live remediation safety
MAX_DISCOVERY_AGE_HOURS=24

### Frontend container deployment (copy values into .env; never commit secrets)
POSTGRES_PASSWORD=replace-with-a-strong-local-password
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes
AUTH_OIDC_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPE=openid profile email groups aws_account_scopes
