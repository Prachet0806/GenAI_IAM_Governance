### Core database — DO NOT commit real credentials. Copy to .env locally.
# SQLite (local):
DB_URL=sqlite:///iam_governance.db
# Postgres (set via secrets manager in prod; example only):
# DB_URL=postgres://USER:***@HOST:5432/iam_governance?sslmode=require

### AWS + region
AWS_REGION=us-east-1
# AWS_PROFILE=default

### IAM discovery
# false routes all AWS-shaped clients to local Floci; true uses live AWS.
MOCK_IAM=false
# Separate deterministic dataset for tests and CLI auto-demo; do not combine with MOCK_IAM=true.
SEEDED_IAM=false
FLOCI_ENDPOINT_URL=http://127.0.0.1:4566
FLOCI_ACCOUNT_ID=111111111111
# In Floci mode this must match FLOCI_ACCOUNT_ID. In live mode set the real account.
AWS_ACCOUNT_ID=111111111111

### Safety gates (remediation)
DRY_RUN=true
ENABLE_REMEDIATION=false
ALLOW_LIVE_REMEDIATION=false
ALLOW_EMULATOR_MUTATION=false
REMEDIATION_ALLOWLIST=
REMEDIATION_DENYLIST=
# Staging live AWS actions additionally require APP_ENV=staging, real AWS_ACCOUNT_ID,
# and a recorded acceptance identifier. Emulator mutation requires APP_ENV=emulator,
# ALLOW_EMULATOR_MUTATION=true, and a non-empty allowlist. Production is blocked.
STAGING_REMEDIATION_ACCEPTANCE_ID=
REMEDIATION_WORKER_ID=

### Audit export
AUDIT_S3_BUCKET=
AUDIT_S3_PREFIX=
LOCAL_ONLY=true

### Logging
LOG_LEVEL=INFO

### GenAI (optional)
# Disabled by default. Review docs/ai-governance.md and docs/production-readiness.md.
ENABLE_GENAI=false
ENABLE_REVIEW_QA=false
AI_MAX_CALLS_PER_INVOCATION=10
# AI_TELEMETRY_KEY=  # 32+ byte deployment secret required when Q&A is enabled
# AI_PROVIDER_REGION=global  # API-key client has no configured regional routing
# AI_PROVIDER_APPROVAL_JSON=  # versioned approval record; see docs/ai-governance.md
# GOOGLE_API_KEY=
# GENAI_MODEL=gemini-3.8-flash
AI_PROVIDER_DATA_APPROVED=false
# AI_PSEUDONYM_KEY=provide-via-secret-manager

### Environment and OIDC reviewer API
APP_ENV=development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_GROUP_CLAIM=groups
OIDC_ACCOUNT_SCOPE_CLAIM=aws_account_scopes
# Development-only global access requires an explicit opt-in. Keep false for shared environments.
OIDC_ALLOW_GLOBAL_SCOPE=false
# Development-only manual reviewer-subject entry; a directory verifier is required for staging/production.
OIDC_ALLOW_UNVERIFIED_REVIEWER_ASSIGNMENTS=false
REVIEWER_GROUP=
CAMPAIGN_ADMIN_GROUP=
REMEDIATION_APPROVER_GROUP=
REMEDIATION_OPERATOR_GROUP=
AUDITOR_GROUP=

### Live remediation safety
MAX_DISCOVERY_AGE_HOURS=24

### Frontend container deployment (copy values into .env; never commit secrets)
POSTGRES_PASSWORD=replace-with-a-strong-local-password
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes
AUTH_OIDC_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPE=openid profile email groups aws_account_scopes
